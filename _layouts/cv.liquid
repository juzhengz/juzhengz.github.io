---
layout: null
---
{%- if page.cv_pdf contains '://' -%}
  {%- assign cv_pdf_url = page.cv_pdf -%}
{%- else -%}
  {%- assign cv_pdf_url = page.cv_pdf | prepend: '/assets/pdf/' | relative_url -%}
{%- endif -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title | escape }}</title>
    <link rel="canonical" href="{{ cv_pdf_url | absolute_url | escape }}">
    <meta http-equiv="refresh" content="0; url={{ cv_pdf_url | escape }}">
    <script>
      window.location.replace({{ cv_pdf_url | jsonify }});
    </script>
  </head>
  <body>
    <p>Opening CV. <a href="{{ cv_pdf_url | escape }}">View the PDF</a> if you are not redirected automatically.</p>
  </body>
</html>
